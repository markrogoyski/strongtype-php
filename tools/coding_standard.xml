<?xml version="1.0"?>
<ruleset name="StrongTypePHP">
 <description>The coding standard for StrongType PHP.</description>

 <config name="php_version" value="80400"/>

 <rule ref="PSR12">
  <!-- Welcome to the future where we have HD wide-screen monitors -->
  <exclude name="Generic.Files.LineLength.TooLong"/>
 </rule>

 <!-- Test files define fixture classes alongside test classes -->
 <rule ref="PSR1.Classes.ClassDeclaration.MultipleClasses">
  <exclude-pattern>tests/</exclude-pattern>
 </rule>

</ruleset>
