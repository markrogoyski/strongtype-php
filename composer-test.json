{
  "name": "markrogoyski/strongtype-php",
  "type": "library",
  "description": "Minimal composer config for CI unit tests on PHP 8.4+",
  "license": "MIT",
  "require": {
    "php": ">=8.4.0",
    "ext-ctype": "*",
    "ext-filter": "*",
    "ext-json": "*"
  },
  "require-dev": {
    "phpunit/phpunit": "^11.5",
    "php-parallel-lint/php-parallel-lint": "^1.4"
  },
  "autoload": {
    "psr-4": { "StrongType\\": "src/" }
  },
  "autoload-dev": {
    "psr-4": { "StrongType\\Tests\\": "tests/" }
  }
}
