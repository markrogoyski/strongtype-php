<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="https://schema.phpunit.de/11.5/phpunit.xsd"
         bootstrap="bootstrap.php"
         colors="true"
         cacheDirectory=".phpunit.cache"
         displayDetailsOnTestsThatTriggerWarnings="true"
         displayDetailsOnTestsThatTriggerDeprecations="true">
  <testsuites>
    <testsuite name="All">
      <directory suffix="Test.php">Float</directory>
      <directory suffix="Test.php">Int</directory>
      <directory suffix="Test.php">String</directory>
      <directory suffix="Test.php">Arrays</directory>
      <directory suffix="Test.php">Bool</directory>
      <directory suffix="Test.php">DateTime</directory>
      <directory suffix="Test.php">Constraint</directory>
      <directory suffix="Test.php">Exception</directory>
      <file>DeserializationTest.php</file>
      <file>EqualsTest.php</file>
      <file>GlobalNamespaceTypeTest.php</file>
      <file>NullableEqualsTest.php</file>
      <file>NullableFactoryTest.php</file>
      <file>NullableTest.php</file>
      <file>ShortClassNameTest.php</file>
      <file>StringifyTest.php</file>
      <file>TryFromTest.php</file>
      <file>ValueEqualityTest.php</file>
    </testsuite>
  </testsuites>
  <source>
    <include>
      <directory suffix=".php">../src/</directory>
    </include>
    <exclude>
      <directory suffix=".php">../vendor/</directory>
    </exclude>
  </source>
  <php>
    <ini name="memory_limit" value="512M"/>
    <!--
      Float string/JSON expectations are hard-coded digit for digit. serialize_precision=-1
      (json_encode's shortest round-trip rendering) and precision=14 are PHP's defaults, not
      language guarantees, so pin both rather than inherit whatever php.ini the runner has.
    -->
    <ini name="serialize_precision" value="-1"/>
    <ini name="precision" value="14"/>
  </php>
</phpunit>
